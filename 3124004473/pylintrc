# -*- coding: utf-8 -*-
# pylint 配置文件 —— 论文查重程序
#
# 用法:
#     set PYLINTHOME=<项目目录>\.pylint.d
#     python -m pylint plagcheck main.py tests
#
# 目标: 0 告警、10.00/10。
#
# 本文件里每一条 disable 都写明了理由。凡是"能改代码消除"的告警都直接
# 改代码（例如把 %-格式化统一换成 f-string、清理不可达的防御分支），
# 只有下面这几条属于工具本身的误报或本项目的约定，才在这里关闭。

[MASTER]
# 与源码同级的包目录可以直接被导入，无需安装。
init-hook =
    import sys
    sys.path.insert(0, '.')

[FORMAT]
max-line-length = 110

# 关掉"模块名/文件名"风格检查：本项目的文件名都是 main.py、tests/ 之类的
# 约定俗成的名字，不需要按包规则命名。
[MESSAGES CONTROL]
disable =
    # __future__ 导入按 PEP 8 必须排在最前面，但 pylint 会把它当作
    # "未与标准库分组"报 C0412——这是已知误报，无法通过改代码消除。
    ungrouped-imports,
    # 显式再导出（re-export）要求 __all__ 里逐字列出源模块的名字，
    # 这必然与源模块的 __all__ 出现大段重复文本。R0801 对
    # plagcheck/__init__.py 与 plagcheck/exceptions.py 的 __all__ 列表
    # 报 duplicate-code，属于把"刻意的显式契约"误判为坏味道。
    duplicate-code,
    # 测试与脚本里大量使用 pytest 夹具名作为参数（write_file、tmp_path…），
    # 以及用 _ 前缀表示"本用例不关心"的变量。
    too-many-public-methods,
    too-few-public-methods,
    # 说明：本项目刻意不使用 dataclass 之外的设计模式，R0903 会对
    # 只有一两个方法的辅助类（如测试里的桩对象）报警。
    protected-access

[BASIC]
# n 是 n-gram 窗口长度的通用记法（n-gram 的 n），保留它比改名更清晰。
good-names = i, j, k, n, ex, Run, _

[TYPECHECK]
# 本项目的类型注解是给人看的文档，不做运行期校验。
ignored-modules =

[REPORTS]
output-format = text
reports = no
score = yes
